# RiftHub local environment template.
# Copy this file to `.env` and edit the values for your machine.
# The application loads `.env` at runtime. It does not load `.env.example`.

# App
RIFTHUB_ENV=development
RIFTHUB_LOG_LEVEL=INFO
RIFTHUB_API_HOST=127.0.0.1
RIFTHUB_API_PORT=8000
RIFTHUB_SQL_ECHO=false

# Postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=rifthub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# SQLAlchemy / Alembic
RIFTHUB_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/rifthub
RIFTHUB_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/rifthub

# Rate limiting
# Local development defaults to the in-memory limiter. Production should use:
# RIFTHUB_RATE_LIMIT_BACKEND=redis
# RIFTHUB_REDIS_URL=redis://...
RIFTHUB_RATE_LIMIT_BACKEND=memory
RIFTHUB_REDIS_URL=
RIFTHUB_RATE_LIMIT_PREFIX=rifthub:rate-limit
RIFTHUB_PROXY_SECRET=

# Auth and email (development defaults are fine; leave these empty locally)
RIFTHUB_APP_SECRET=
RIFTHUB_FRONTEND_BASE_URL=http://localhost:3000
RIFTHUB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RIFTHUB_VERIFICATION_DELIVERY_MODE=log
RIFTHUB_VERIFICATION_FROM_EMAIL=noreply@localhost
RIFTHUB_RESEND_API_KEY=

# Production checklist. The API refuses to start unless these are all set:
#   RIFTHUB_ENV=production
#   RIFTHUB_APP_SECRET=<random, 32+ chars>           e.g. `openssl rand -hex 32`
#   RIFTHUB_PROXY_SECRET=<random, 32+ chars>         same value on web and API
#   RIFTHUB_FRONTEND_BASE_URL=https://your-domain
#   RIFTHUB_ALLOWED_ORIGINS=https://your-domain
#   RIFTHUB_REDIS_URL=redis://...
#   RIFTHUB_VERIFICATION_DELIVERY_MODE=resend
#   RIFTHUB_RESEND_API_KEY=re_...
#   RIFTHUB_VERIFICATION_FROM_EMAIL=RiftHub <noreply@your-verified-domain>

# Worker bot account
RIFTHUB_INGESTION_SYSTEM_USERNAME=rifthub_bot
RIFTHUB_INGESTION_SYSTEM_EMAIL=ingestion-bot@localhost
